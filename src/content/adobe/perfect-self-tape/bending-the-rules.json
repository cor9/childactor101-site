    "title": "Bending The Rules",
    "subtitle": "Make it Count",
    "image": "/courses/perfect-self-tape/bending-the-rules/images/3a4601f5-93a3-446b-9847-90eb62964ce2.jpg",
    "imageWidth": 600,
