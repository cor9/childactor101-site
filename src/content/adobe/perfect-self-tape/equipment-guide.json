      "elements": [
        {
          "type": "blockquote",
          "html": "Superb Self Tapes are sent out everyday using Smartphones and Tablets. Most newer models record at a quality so high that isn’t even necessary for a Self Tape."
        },
        {
          "type": "image",
          "src": "/courses/perfect-self-tape/equipment-guide/images/EB4A4237-DFB8-49EC-BFD7-90869544900E.jpg",
          "width": 600,
          "height": 400
        },
        {
          "type": "image",
          "src": "/courses/perfect-self-tape/equipment-guide/images/B0FB5FDC-BAF1-420B-8AF2-1E95753C9986.jpg",
          "width": 651,
          "height": 700
        },
        {
          "type": "blockquote",
          "html": "720p will deliver exceptional looking results"
        },
        {
          "type": "image",
          "src": "/courses/perfect-self-tape/equipment-guide/images/D827F11D-F3A4-4D0D-AE62-AA466B31FC41.jpg",
          "width": 626,
